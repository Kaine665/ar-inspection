# 开发环境：npm run dev
#
# VITE_ 前缀的变量才会被 Vite 注入到前端代码里（见 src/config.ts）。
# 不带 VITE_ 的只在 node 侧用（vite.config.ts 读），不会打进浏览器包。

# 留空 = 走 vite 代理（/api → ADMIN_PROXY_TARGET），浏览器看到的是同源请求
VITE_API_BASE=

# 单次请求超时（毫秒）
VITE_API_TIMEOUT_MS=8000

# 后端不在默认端口时改这一行（vite.config.ts 读它，不是 VITE_ 前缀）
ADMIN_PROXY_TARGET=http://127.0.0.1:8080
